<Window x:Class="ChromeProfileLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ChromeProfileLauncher.ViewModels"
        xmlns:helpers="clr-namespace:ChromeProfileLauncher.Helpers"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="500"
        Title="Settings" Height="{Binding WindowHeight, Mode=TwoWay}" Width="{Binding WindowWidth, Mode=TwoWay}"
        Top="{Binding WindowTop, Mode=TwoWay}" Left="{Binding WindowLeft, Mode=TwoWay}"
        Icon="pack://application:,,,/ChromeProfileLauncher;component/Assets/app.ico"
        Background="#0F0F0F" Foreground="White"
        Closing="Window_Closing"
        FontFamily="Segoe UI, Meiryo, Yu Gothic UI, Roboto, Helvetica Neue, Arial">

    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <helpers:IconPathToImageConverter x:Key="IconPathToImageConverter" />

        <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <!-- Colors -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F0F0F" />
        <SolidColorBrush x:Key="ItemBackgroundBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#3366FF" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="White" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#333333" />

        <!-- Toggle Switch Style (CheckBox) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="RootGrid" Cursor="Hand">
                            <Border x:Name="BackgroundBorder" Background="#333" Width="44" Height="24" CornerRadius="12" />
                            <Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" HorizontalAlignment="Left" Margin="3,0" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="ModernListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="MainBorder" 
                                Background="{StaticResource ItemBackgroundBrush}" 
                                CornerRadius="20" 
                                Padding="15,12"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallOpenButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Content" Value="OPEN" />
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Launcher Settings" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Launch at Startup" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                <CheckBox IsChecked="{Binding LaunchAtStartup}" 
                          Style="{StaticResource ToggleSwitchStyle}" 
                          VerticalAlignment="Center" Margin="0,0,20,0" />

                <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="アップデートを確認" 
                        Style="{StaticResource OutlineButtonStyle}" 
                        Padding="12,5" 
                        FontSize="12"
                        Command="{Binding CheckForUpdatesCommand}"
                        IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBooleanConverter}}" />
            </StackPanel>
        </Grid>


        <ListBox Grid.Row="2" 
                 ItemsSource="{Binding Profiles}" 
                 Background="Transparent" 
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                 HorizontalContentAlignment="Stretch" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                 MouseMove="ListBox_MouseMove"
                 DragOver="ListBox_DragOver"
                 DragLeave="ListBox_DragLeave"
                 Drop="ListBox_Drop">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" /> <!-- Handle -->
                            <ColumnDefinition Width="60" /> <!-- Icon -->
                            <ColumnDefinition Width="*" />  <!-- Name & ID -->
                            <ColumnDefinition Width="Auto" /> <!-- Toggle -->
                            <ColumnDefinition Width="Auto" /> <!-- Open Button -->
                        </Grid.ColumnDefinitions>

                        <!-- Handle -->
                        <TextBlock Text="☰" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                   FontSize="20" Foreground="#555" Cursor="SizeAll" />

                        <!-- Icon -->
                        <Border Grid.Column="1" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{Binding IconPath, Converter={StaticResource IconPathToImageConverter}}" Width="32" Height="32" />
                        </Border>

                        <!-- Name & ID -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="{Binding Id, StringFormat='/{0}'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Visibility Toggle -->
                        <CheckBox Grid.Column="3" IsChecked="{Binding IsVisible}" 
                                  Style="{StaticResource ToggleSwitchStyle}" 
                                  VerticalAlignment="Center" Margin="10,0" />

                        <!-- Open Folder Button -->
                        <Button Grid.Column="4" 
                                Style="{StaticResource SmallOpenButtonStyle}"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                VerticalAlignment="Center" Margin="5,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 " FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="OPEN" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="キャンセル" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0" IsCancel="True" Height="45" />
            <Button Grid.Column="1" Content="保存" Style="{StaticResource ModernButtonStyle}" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" IsDefault="True" Height="45" />
        </Grid>
    </Grid>
</Window>
