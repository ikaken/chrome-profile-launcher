<Window x:Class="ChromeProfileLauncher.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Source={StaticResource Resources}, Path=FirstRunTitle}"
        Icon="pack://application:,,,/ChromeProfileLauncher;component/Assets/app.ico"
        Width="520" Height="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F0F0F">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Source={StaticResource Resources}, Path=FirstRunHeading}"
                   FontSize="26" FontWeight="SemiBold" Foreground="White" />
        <TextBlock Grid.Row="1"
                   Text="{Binding Source={StaticResource Resources}, Path=FirstRunDescription}"
                   Margin="0,12,0,24" FontSize="14" Foreground="#B8B8B8" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2">
            <Border Background="#222222" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                    <CheckBox Content="{Binding Source={StaticResource Resources}, Path=LaunchAtStartup}"
                              IsChecked="{Binding LaunchAtStartup}" />
                    <TextBlock Text="{Binding Source={StaticResource Resources}, Path=LaunchAtStartupDescription}"
                               Margin="24,8,0,0" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="#222222" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <CheckBox Content="{Binding Source={StaticResource Resources}, Path=EnableTaskTray}"
                              IsChecked="{Binding EnableTaskTray}" />
                    <TextBlock Text="{Binding Source={StaticResource Resources}, Path=EnableTaskTrayDescription}"
                               Margin="24,8,0,0" FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Button Grid.Row="3" Content="{Binding Source={StaticResource Resources}, Path=FirstRunContinue}"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Right" MinWidth="130" Padding="20,10"
                Background="#3478F6" Foreground="White" BorderThickness="0" FontSize="14" />
    </Grid>
</Window>
